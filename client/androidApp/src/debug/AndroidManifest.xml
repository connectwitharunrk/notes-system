<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Debug only. The development backend runs on plain http, and the emulator
        reaches the host at 10.0.2.2. Release builds keep Android's default of
        rejecting cleartext, so this can never ship.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />

</manifest>
